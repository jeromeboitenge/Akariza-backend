generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  fullName            String
  role                String    @default("SYSTEM_ADMIN")
  isActive            Boolean   @default(true)
  otpCode             String?
  otpExpiry           DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organizations Organization[]
  branches      Branch[]
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  businessType String
  address      String
  phone        String
  email        String
  isActive     Boolean  @default(true)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy         Admin              @relation(fields: [createdById], references: [id])
  users             User[]
  branches          Branch[]
  products          Product[]
  suppliers         Supplier[]
  purchases         Purchase[]
  sales             Sale[]
  stockTransactions StockTransaction[]
  auditLogs         AuditLog[]
  messages          Message[]
  expenseCategories ExpenseCategory[]
}

model User {
  id                  String    @id @default(uuid())
  organizationId      String
  branchId            String?
  email               String
  password            String
  fullName            String
  role                String
  isActive            Boolean   @default(true)
  refreshToken        String?
  otpCode             String?
  otpExpiry           DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastPasswordChange  DateTime  @default(now())
  passwordHistory     String[]  @default([])
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  branch            Branch?            @relation("BranchUsers", fields: [branchId], references: [id])
  employee          Employee?
  createdProducts   Product[]          @relation("ProductCreator")
  createdSuppliers  Supplier[]         @relation("SupplierCreator")
  createdPurchases  Purchase[]         @relation("PurchaseCreator")
  createdSales      Sale[]             @relation("SaleCreator")
  stockTransactions StockTransaction[] @relation("StockTransactionCreator")
  auditLogs         AuditLog[]
  sentMessages      Message[]          @relation("SentMessages")
  receivedMessages  Message[]          @relation("ReceivedMessages")

  @@unique([organizationId, email])
}

model Product {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  sku            String
  category       String    @default("General")
  unit           String    @default("piece")
  costPrice      Float
  sellingPrice   Float
  currentStock   Float     @default(0)
  minStockLevel  Float     @default(0)
  maxStockLevel  Float     @default(0)
  reorderPoint   Float     @default(0)
  hasExpiry      Boolean   @default(false)
  expirationDate DateTime?
  trackBatch     Boolean   @default(false)
  trackSerial    Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization      Organization       @relation(fields: [organizationId], references: [id])
  createdBy         User               @relation("ProductCreator", fields: [createdById], references: [id])
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  stockTransactions StockTransaction[]
  branchInventory   BranchInventory[]
  batches           ProductBatch[]
  barcodes          ProductBarcode[]
  priceHistory      PriceHistory[]
  promotions        PromotionProduct[]
  poItems           PurchaseOrderItem[]
  transferItems     StockTransferItem[]

  @@unique([organizationId, sku])
}

model Supplier {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  contactPerson  String
  phone          String
  email          String?
  address        String
  rating         Float    @default(0)
  creditLimit    Float    @default(0)
  paymentTerms   String?
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  createdBy      User            @relation("SupplierCreator", fields: [createdById], references: [id])
  purchases      Purchase[]
  purchaseOrders PurchaseOrder[]
}

model Purchase {
  id                String   @id @default(uuid())
  organizationId    String
  branchId          String?
  purchaseNumber    String
  supplierId        String
  totalAmount       Float
  discount          Float    @default(0)
  tax               Float    @default(0)
  finalAmount       Float
  paymentStatus     String   @default("UNPAID")
  amountPaid        Float    @default(0)
  notes             String?
  syncedFromMobile  Boolean  @default(false)
  mobileRecordId    String?
  createdById       String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id])
  branch       Branch?        @relation(fields: [branchId], references: [id])
  supplier     Supplier       @relation(fields: [supplierId], references: [id])
  createdBy    User           @relation("PurchaseCreator", fields: [createdById], references: [id])
  items        PurchaseItem[]

  @@unique([organizationId, mobileRecordId])
}

model PurchaseItem {
  id         String @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Float
  costPrice  Float
  total      Float

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model Sale {
  id               String   @id @default(uuid())
  organizationId   String
  branchId         String?
  customerId       String?
  saleNumber       String
  totalAmount      Float
  discount         Float    @default(0)
  tax              Float    @default(0)
  finalAmount      Float
  amountPaid       Float    @default(0)
  change           Float    @default(0)
  paymentMethod    String
  paymentStatus    String   @default("PAID")
  customerName     String?
  syncedFromMobile Boolean  @default(false)
  mobileRecordId   String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdBy    User         @relation("SaleCreator", fields: [createdById], references: [id])
  items        SaleItem[]

  @@unique([organizationId, mobileRecordId])
  @@index([organizationId, createdAt])
}

model SaleItem {
  id           String @id @default(uuid())
  saleId       String
  productId    String
  quantity     Float
  sellingPrice Float
  costPrice    Float
  total        Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model StockTransaction {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  type           String
  quantity       Float
  referenceType  String
  referenceId    String
  balanceAfter   Float
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  createdBy    User         @relation("StockTransactionCreator", fields: [createdById], references: [id])

  @@index([organizationId, productId, createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String
  action         String
  resource       String
  resourceId     String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

// ============= BRANCHES =============
model Branch {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String
  phone          String
  email          String?
  isActive       Boolean  @default(true)
  isMainBranch   Boolean  @default(false)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id])
  createdBy         Admin               @relation(fields: [createdById], references: [id])
  users             User[]              @relation("BranchUsers")
  products          BranchInventory[]
  sales             Sale[]
  purchases         Purchase[]
  stockTransfers    StockTransfer[]     @relation("TransferFrom")
  receivedTransfers StockTransfer[]     @relation("TransferTo")
  sentMessages      Message[]           @relation("SentFromBranch")
  receivedMessages  Message[]           @relation("SentToBranch")

  @@unique([organizationId, code])
}

model BranchInventory {
  id         String   @id @default(uuid())
  branchId   String
  productId  String
  quantity   Float    @default(0)
  minLevel   Float    @default(0)
  maxLevel   Float    @default(0)
  updatedAt  DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([branchId, productId])
}

model StockTransfer {
  id             String   @id @default(uuid())
  organizationId String
  transferNumber String
  fromBranchId   String
  toBranchId     String
  status         String   @default("PENDING")
  notes          String?
  createdById    String
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items      StockTransferItem[]
}

model StockTransferItem {
  id         String @id @default(uuid())
  transferId String
  productId  String
  quantity   Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])
}

// ============= CUSTOMERS =============
model Customer {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  email          String?
  phone          String
  address        String?
  customerType   String   @default("REGULAR")
  loyaltyPoints  Int      @default(0)
  creditLimit    Float    @default(0)
  currentDebt    Float    @default(0)
  notes          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sales            Sale[]
  transactions     CustomerTransaction[]
  loyaltyHistory   LoyaltyTransaction[]

  @@index([organizationId, phone])
}

model CustomerTransaction {
  id         String   @id @default(uuid())
  customerId String
  type       String
  amount     Float
  balance    Float
  notes      String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  customerId String
  points     Int
  type       String
  reference  String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
}

// ============= EMPLOYEES =============
model Employee {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   @unique
  employeeCode   String
  department     String?
  position       String?
  salary         Float?
  commissionRate Float    @default(0)
  hireDate       DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user       User                 @relation(fields: [userId], references: [id])
  attendance EmployeeAttendance[]
  targets    EmployeeTarget[]

  @@unique([organizationId, employeeCode])
}

model EmployeeAttendance {
  id         String    @id @default(uuid())
  employeeId String
  date       DateTime
  checkIn    DateTime?
  checkOut   DateTime?
  status     String    @default("PRESENT")
  notes      String?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model EmployeeTarget {
  id         String   @id @default(uuid())
  employeeId String
  month      DateTime
  target     Float
  achieved   Float    @default(0)
  commission Float    @default(0)

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month])
}

// ============= ADVANCED INVENTORY =============
model ProductBatch {
  id            String    @id @default(uuid())
  productId     String
  batchNumber   String
  expiryDate    DateTime?
  manufactureDate DateTime?
  quantity      Float
  costPrice     Float
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, batchNumber])
}

model ProductBarcode {
  id        String @id @default(uuid())
  productId String
  barcode   String @unique
  type      String @default("EAN13")

  product Product @relation(fields: [productId], references: [id])
}

// ============= PRICING & PROMOTIONS =============
model PriceHistory {
  id            String   @id @default(uuid())
  productId     String
  oldPrice      Float
  newPrice      Float
  changeReason  String?
  changedBy     String
  createdAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
}

model Promotion {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  type           String
  discountType   String
  discountValue  Float
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean   @default(true)
  conditions     Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  products PromotionProduct[]
}

model PromotionProduct {
  id          String @id @default(uuid())
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([promotionId, productId])
}

// ============= PURCHASE ORDERS =============
model PurchaseOrder {
  id             String   @id @default(uuid())
  organizationId String
  poNumber       String
  supplierId     String
  status         String   @default("DRAFT")
  totalAmount    Float
  notes          String?
  expectedDate   DateTime?
  createdById    String
  approvedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier           @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]

  @@unique([organizationId, poNumber])
}

model PurchaseOrderItem {
  id        String @id @default(uuid())
  poId      String
  productId String
  quantity  Float
  unitPrice Float
  total     Float

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
}

// ============= EXPENSES =============
// ============= EXPENSES =============
model ExpenseCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Expense {
  id             String   @id @default(uuid())
  organizationId String
  category       String
  amount         Float
  description    String
  date           DateTime
  paymentMethod  String?
  receiptUrl     String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([organizationId, date])
}

// ============= NOTIFICATIONS =============
model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ============= COLLABORATION =============
model Task {
  id             String    @id @default(uuid())
  organizationId String
  title          String
  description    String?
  assignedTo     String
  assignedBy     String
  status         String    @default("PENDING")
  priority       String    @default("MEDIUM")
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  comments TaskComment[]

  @@index([organizationId, assignedTo])
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  comment   String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Message {
  id             String   @id @default(uuid())
  organizationId String
  senderId       String
  senderBranchId String?
  receiverId     String?
  receiverBranchId String?
  targetType     String   @default("USER") // USER, BRANCH, ALL_BRANCHES
  message        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization     Organization @relation(fields: [organizationId], references: [id])
  sender           User         @relation("SentMessages", fields: [senderId], references: [id])
  receiver         User?        @relation("ReceivedMessages", fields: [receiverId], references: [id])
  senderBranch     Branch?      @relation("SentFromBranch", fields: [senderBranchId], references: [id])
  receiverBranch   Branch?      @relation("SentToBranch", fields: [receiverBranchId], references: [id])

  @@index([organizationId, receiverId, isRead])
  @@index([organizationId, receiverBranchId])
}

model Note {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  userId     String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
}

// ============= ANALYTICS =============
model DailySummary {
  id             String   @id @default(uuid())
  organizationId String
  branchId       String?
  date           DateTime
  totalSales     Float    @default(0)
  totalPurchases Float    @default(0)
  totalExpenses  Float    @default(0)
  profit         Float    @default(0)
  transactions   Int      @default(0)
  createdAt      DateTime @default(now())

  @@unique([organizationId, branchId, date])
  @@index([organizationId, date])
}

// ============= SECURITY =============
model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  ipAddress  String
  userAgent  String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model TwoFactorAuth {
  id        String   @id @default(uuid())
  userId    String   @unique
  secret    String
  isEnabled Boolean  @default(false)
  createdAt DateTime @default(now())
}
